    "Plus petit : moins de retard, plus de risques de craquements. Klick prend celui que la sortie utilise.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaller: less delay, more risk of crackles. Klick takes the one the output uses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleiner: weniger Verzögerung, mehr Gefahr von Knacksern. Klick übernimmt den, den die Ausgabe nutzt."
          }
        },
        "it": {
